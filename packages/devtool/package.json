{
  "name": "@agentskillmania/skill-ui-devtool",
  "version": "1.0.1-alpha.1",
  "description": "Devtool UI components for @agentskillmania — eval report viewer and companions.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:coverage": "vitest run test/unit --coverage",
    "test:watch": "vitest watch test/unit",
    "prepublishOnly": "pnpm test:unit && pnpm build",
    "storybook": "storybook dev -p 6014",
    "build-storybook": "storybook build"
  },
  "author": {
    "name": "yusangeng",
    "email": "yusangeng@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/agentskillmania/skill-ui.git",
    "directory": "packages/devtool"
  },
  "dependencies": {
    "@agentskillmania/skill-ui-shared": "workspace:*",
    "@agentskillmania/skill-ui-theme": "workspace:*"
  },
  "peerDependencies": {
    "@agentskillmania/wrangler-devtool": "^0.2.1",
    "antd": "^6.0.0",
    "i18next": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "@emotion/react": "^11.0.0"
  },
  "devDependencies": {
    "@agentskillmania/wrangler-devtool": "^0.2.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "antd": "^6.3.3",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "i18next": "^24.0.0",
    "react-i18next": "^15.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "@chromatic-com/storybook": "^5.0.2",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "storybook": "^10.3.3",
    "vite": "^5.4.21",
    "@vitejs/plugin-react": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
