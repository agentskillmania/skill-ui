    "@agentskillmania/skill-ui-chat": "workspace:*",
    "@agentskillmania/skill-ui-cockpit": "workspace:*",
    "@agentskillmania/skill-ui-editor": "workspace:*",
    "@agentskillmania/skill-ui-frame": "workspace:*",
    "@agentskillmania/skill-ui-state": "workspace:*",
    "@agentskillmania/skill-ui-theme": "workspace:*",
    "@ant-design/x": "^2.4.0",
    "antd": "^6.3.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "i18next": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0"
