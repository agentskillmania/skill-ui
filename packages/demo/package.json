{
  "name": "@agentskillmania/skill-ui-chat-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm exec tsx watch server/index.ts\" \"pnpm exec vite\"",
