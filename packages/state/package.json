  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
